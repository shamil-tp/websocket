<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Real-Time Group Chat</title>
    <!-- Google Fonts for typography -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <!-- Name Prompt Modal -->
    <div id="name-modal" class="modal">
        <div class="modal-content">
            <h2>Welcome to GroupChat</h2>
            <p>Please enter your name to join the room</p>
            <form id="name-form">
                <input type="text" id="name-input" placeholder="Your Name" required autocomplete="off">
                <button type="submit" class="btn-primary">Join Chat</button>
            </form>
        </div>
    </div>

    <!-- Main Chat Interface -->
    <div id="chat-app" class="hidden">
        <header class="chat-header">
            <h1>GroupChat 💬</h1>
            <span id="user-display"></span>
        </header>

        <main class="chat-main">
            <div id="chat-messages" class="messages-container">
                <!-- Messages will appear here -->
            </div>
        </main>

        <footer class="chat-footer">
            <form id="chat-form">
                <input type="text" id="msg-input" placeholder="Type a message..." required autocomplete="off">
                <button type="submit" class="btn-send">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-send"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                </button>
            </form>
        </footer>
    </div>

    <!-- Socket.IO Client Script -->
    <script src="/socket.io/socket.io.js"></script>
    <script src="/chat.js"></script>
</body>
</html>
